<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Pinned to a specific API level (not just "net10.0-android") so the compiled/target SDK is
         explicit and doesn't silently shift when a newer Android workload is installed. 36
         (Android 16) matches Google Play's target API requirement for new/updated app submissions
         as of August 31, 2026. -->
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.mellow.smarteditor</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Play Console requires an Android App Bundle, not a raw APK, for new app submissions. -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!-- Release signing: only wired up for Release builds, and only once
       ANDROID_SIGNING_KEY_STORE is actually set in the environment (e.g. in a local shell before
       `dotnet publish`, or as CI secrets) — nothing here is a committed secret. Without it, a
       Release build/publish falls back to the debug key rather than failing. AndroidKeyStore
       must be explicitly set to true — it defaults to false, and without it the
       AndroidSigning* properties below are silently ignored and the debug key is used instead
       (which is exactly what produced a debug-signed AAB that Google Play then rejected). -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' AND '$(ANDROID_SIGNING_KEY_STORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(ANDROID_SIGNING_KEY_STORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(ANDROID_SIGNING_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(ANDROID_SIGNING_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartEditor.App\SmartEditor.App.csproj" />
  </ItemGroup>
</Project>
