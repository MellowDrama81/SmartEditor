<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:CompileBindings="False"
             x:Class="SmartEditor.App.Views.AssetsView">

  <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
    <!-- WrapPanel, not DockPanel: on a narrow phone screen these controls don't all fit on one
         line, so they need to wrap onto a second line instead of forcing this view (and the
         overlay/window hosting it) wider than the screen. -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
      <Button Content="Add files…" Command="{Binding AddFilesCommand}" />
      <Button Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                   Width="20" Height="20" Margin="8,0,0,0" />
      <TextBox Text="{Binding TagFilter}" PlaceholderText="Filter by tag…" MinWidth="160" Margin="12,4,0,0" />
      <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                 Margin="12,4,0,0" MaxWidth="300" TextWrapping="Wrap" />
    </WrapPanel>

    <ScrollViewer Grid.Row="1" ScrollChanged="OnAssetsScrollChanged">
      <Panel>
        <TextBlock Text="No assets loaded yet — click Refresh to list what's already uploaded to ComfyUI."
                   IsVisible="{Binding !HasAssets}" Opacity="0.7" Margin="0,20,0,0" />

        <ItemsControl ItemsSource="{Binding FilteredAssets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="176" Margin="4" Padding="8" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="4">
                  <Grid Height="120">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                    <TextBlock Text="Loading…" IsVisible="{Binding IsLoadingThumbnail}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                  </Grid>
                  <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                  <TextBlock Text="{Binding Filename}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Filename}" />
                  <TextBox Text="{Binding TagsText}" PlaceholderText="tags, comma, separated" FontSize="11" />
                  <Button Content="Download" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding $parent[ItemsControl].DataContext.DownloadCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
