<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SmartEditor.App.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:CompileBindings="False"
             x:Class="SmartEditor.App.Views.EditorView">

  <Grid>
    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,12,0,0">

        <TextBlock Text="Source images (0-8)" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Images}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="96" Height="96" Margin="4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveImageCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Add images…" Command="{Binding AddImagesCommand}" />
          <Button Content="Add from Assets…" Command="{Binding OpenAssetPickerCommand}" />
          <Button Content="Paint mask on image #1" Command="{Binding OpenMaskEditorCommand}" IsEnabled="{Binding CanEditMask}" />
          <Button Content="Clear mask" Command="{Binding ClearMaskCommand}" IsVisible="{Binding HasMask}" />
          <TextBlock Text="Mask set ✓" VerticalAlignment="Center" IsVisible="{Binding HasMask}" Foreground="ForestGreen" />
        </StackPanel>

        <TextBlock Text="Prompt" FontWeight="SemiBold" />
        <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                  PlaceholderText="Describe the edit you want…" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Run" Command="{Binding RunCommand}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="Iteration history" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,4" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding ResultImage}" Width="80" Height="80" Stretch="UniformToFill" />
                  <StackPanel MaxWidth="500">
                    <TextBlock FontWeight="SemiBold">
                      <Run Text="Iteration " /><Run Text="{Binding Index}" /><Run Text=" — workflow: " /><Run Text="{Binding WorkflowId}" />
                    </TextBlock>
                    <TextBlock Text="{Binding RefinedPrompt}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding JudgeFeedback}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
                    <TextBlock Text="Satisfied" Foreground="ForestGreen" IsVisible="{Binding Satisfied}" FontWeight="Bold" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Result" FontWeight="SemiBold" IsVisible="{Binding HasFinalResult}" />
        <Image Source="{Binding FinalResult}" MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Left"
               IsVisible="{Binding HasFinalResult}" />
        <Button Content="Save result…" Command="{Binding SaveResultCommand}" IsVisible="{Binding HasFinalResult}" />

      </StackPanel>
    </ScrollViewer>

    <!-- Mask editor overlay, scoped to this tab -->
    <Grid Background="#AA000000" IsVisible="{Binding IsMaskEditorOpen}">
      <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="16" CornerRadius="6"
              MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Paint mask on the first image" FontWeight="Bold" FontSize="16" />
          <Viewbox MaxWidth="480" MaxHeight="480" Stretch="Uniform">
            <Grid Width="{Binding FirstImage.Thumbnail.PixelSize.Width}"
                  Height="{Binding FirstImage.Thumbnail.PixelSize.Height}">
              <Image Source="{Binding FirstImage.Thumbnail}" />
              <controls:MaskCanvas Name="MaskCanvasControl"
                                    MaskSize="{Binding FirstImage.Thumbnail.PixelSize}"
                                    BrushRadius="{Binding BrushRadius}"
                                    IsErasing="{Binding IsErasing}"
                                    Opacity="0.55" />
            </Grid>
          </Viewbox>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Brush size" VerticalAlignment="Center" />
            <Slider Minimum="4" Maximum="120" Value="{Binding BrushRadius}" Width="160" VerticalAlignment="Center" />
            <ToggleButton Content="Erase" IsChecked="{Binding IsErasing}" />
            <Button Content="Clear" Click="OnClearMaskCanvasClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseMaskEditorCommand}" />
            <Button Content="Done" Click="OnConfirmMaskClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Asset-library picker overlay: browse/select from what's already on the Comfy backend. -->
    <Grid Background="#AA000000" IsVisible="{Binding IsAssetPickerOpen}">
      <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="16" CornerRadius="6"
              Width="640" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="Add source images from Comfy assets" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

          <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="Refresh" DockPanel.Dock="Left" Command="{Binding AssetLibrary.RefreshCommand}" />
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" IsVisible="{Binding AssetLibrary.IsLoading}"
                         Width="18" Height="18" Margin="8,0,0,0" />
            <TextBlock Text="{Binding AssetLibrary.StatusMessage}" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="12,0,0,0" TextWrapping="Wrap" />
            <TextBox Text="{Binding AssetLibrary.TagFilter}" PlaceholderText="Filter by tag…" MinWidth="140" Margin="12,0,0,0" />
          </DockPanel>

          <ScrollViewer Grid.Row="2" ScrollChanged="OnAssetPickerScrollChanged">
            <Panel>
              <TextBlock Text="No assets loaded yet — click Refresh." IsVisible="{Binding !AssetLibrary.HasAssets}"
                         Opacity="0.7" Margin="0,20,0,0" />
              <ItemsControl ItemsSource="{Binding AssetLibrary.FilteredAssets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="140" Margin="4" Padding="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                      <StackPanel Spacing="4">
                        <Grid Height="90">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                          <TextBlock Text="Loading…" IsVisible="{Binding IsLoadingThumbnail}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" FontSize="10" />
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding DisplayName}" />
                        <!-- AddAssetToSourcesCommand lives on EditorViewModel, not on the item
                             itself or on AssetLibrary — $parent[ItemsControl].DataContext is the
                             ItemsControl's own (unscoped, EditorViewModel) DataContext. -->
                        <Button Content="Add" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding $parent[ItemsControl].DataContext.AddAssetToSourcesCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Done" Command="{Binding CloseAssetPickerCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
