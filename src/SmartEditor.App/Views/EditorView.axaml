<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SmartEditor.App.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:CompileBindings="False"
             x:Class="SmartEditor.App.Views.EditorView">

  <Grid>
    <ScrollViewer>
      <!-- Right margin leaves room for the overlay scrollbar so it doesn't sit on top of
           full-width controls like the Prompt TextBox. -->
      <StackPanel Spacing="12" Margin="0,12,16,0">

        <TextBlock Text="Source images (0-8)" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Images}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="96" Height="96" Margin="4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveImageCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- WrapPanel, not StackPanel: these four buttons don't all fit on one line on a narrow
             phone screen in portrait, so they need to wrap onto further lines instead of forcing
             overflow. -->
        <WrapPanel>
          <Button Content="Add images…" Command="{Binding AddImagesCommand}" Margin="0,0,8,4" />
          <Button Content="Add from Assets…" Command="{Binding OpenAssetPickerCommand}" Margin="0,0,8,4" />
          <Button Content="Paint mask on image #1" Command="{Binding OpenMaskEditorCommand}" IsEnabled="{Binding CanEditMask}" Margin="0,0,8,4" />
          <Button Content="Clear mask" Command="{Binding ClearMaskCommand}" IsVisible="{Binding HasMask}" Margin="0,0,8,4" />
          <TextBlock Text="Mask set ✓" VerticalAlignment="Center" IsVisible="{Binding HasMask}" Foreground="ForestGreen" Margin="0,0,0,4" />
        </WrapPanel>

        <TextBlock Text="Workflow" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding WorkflowOptions}" SelectedItem="{Binding SelectedWorkflowOption}"
                  DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Left" MinWidth="220"
                  ToolTip.Tip="Pin this run to a specific workflow instead of letting the LLM choose one. The list only offers workflows that fit the images/mask above." />
        <TextBlock Text="{Binding SelectedWorkflowOption.Description}" IsVisible="{Binding HasSelectedWorkflowDescription}"
                   TextWrapping="Wrap" Opacity="0.8" FontStyle="Italic" />
        <TextBlock Text="No LLM is configured in Settings, so a specific workflow must be picked above — generation runs on Comfy only."
                   IsVisible="{Binding !IsLlmConfigured}" Opacity="0.7" FontStyle="Italic" />

        <CheckBox Content="Refine prompt with LLM" IsChecked="{Binding RefinePromptWithLlm}"
                  IsEnabled="{Binding CanToggleRefinePrompt}"
                  ToolTip.Tip="When off (only possible with a specific workflow pinned above), the LLM isn't used at all — your prompt runs exactly as typed." />
        <TextBlock Text="No LLM will be used for this run — the pinned workflow and prompt (if any) run exactly as given."
                   IsVisible="{Binding !WillUseLlm}" Opacity="0.7" FontStyle="Italic" />

        <TextBlock Text="Prompt" FontWeight="SemiBold" />
        <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                  IsEnabled="{Binding PromptAccepted}"
                  PlaceholderText="Describe the edit you want…" />
        <TextBlock Text="This workflow is purely mechanical and doesn't use a text prompt — you can run it as-is."
                   IsVisible="{Binding !PromptAccepted}" Opacity="0.7" FontStyle="Italic" />

        <!-- WrapPanel, not StackPanel: on a narrow phone screen these controls don't all fit on
             one line, so they need to wrap onto a second line instead of forcing overflow. -->
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,4">
            <TextBlock Text="{Binding IterationsLabel}" VerticalAlignment="Center" />
            <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding MaxIterations}" Width="120" VerticalAlignment="Center"
                    ToolTip.Tip="While the LLM is judging results, this is the max number of retries. Without the LLM, this is exactly how many times it runs — every result is kept." />
            <TextBlock Text="{Binding MaxIterations}" VerticalAlignment="Center" MinWidth="16" />
          </StackPanel>
          <Button Content="Run" Command="{Binding RunCommand}" Margin="0,0,8,4" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" Margin="0,0,8,4" />
          <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" />
        </WrapPanel>

        <TextBlock Text="Iteration history" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,4" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding ResultImage}" Width="80" Height="80" Stretch="UniformToFill" />
                  <StackPanel MaxWidth="500">
                    <TextBlock FontWeight="SemiBold">
                      <Run Text="Iteration " /><Run Text="{Binding Index}" /><Run Text=" — workflow: " /><Run Text="{Binding WorkflowId}" />
                    </TextBlock>
                    <TextBlock Text="{Binding RefinedPrompt}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding JudgeFeedback}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
                    <TextBlock Text="Satisfied" Foreground="ForestGreen" IsVisible="{Binding Satisfied}" FontWeight="Bold" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Result" FontWeight="SemiBold" IsVisible="{Binding HasFinalResult}" />
        <Image Source="{Binding FinalResult}" MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Left"
               IsVisible="{Binding HasFinalResult}" />
        <Button Content="Save result…" Command="{Binding SaveResultCommand}" IsVisible="{Binding HasFinalResult}" />

      </StackPanel>
    </ScrollViewer>

    <!-- Mask editor overlay, scoped to this tab -->
    <Grid Background="#AA000000" IsVisible="{Binding IsMaskEditorOpen}">
      <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="16" CornerRadius="6"
              MaxWidth="560" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Paint mask on the first image" FontWeight="Bold" FontSize="16" />
          <Viewbox MaxWidth="480" MaxHeight="480" Stretch="Uniform">
            <Grid Width="{Binding FirstImage.Thumbnail.PixelSize.Width}"
                  Height="{Binding FirstImage.Thumbnail.PixelSize.Height}">
              <Image Source="{Binding FirstImage.Thumbnail}" />
              <controls:MaskCanvas Name="MaskCanvasControl"
                                    MaskSize="{Binding FirstImage.Thumbnail.PixelSize}"
                                    BrushRadius="{Binding BrushRadius}"
                                    IsErasing="{Binding IsErasing}"
                                    Opacity="0.55" />
            </Grid>
          </Viewbox>
          <!-- WrapPanel, not StackPanel: the label, slider, and two buttons don't all fit on one
               line on a narrow phone screen in portrait, so they need to wrap instead of forcing
               overflow. -->
          <WrapPanel>
            <TextBlock Text="Brush size" VerticalAlignment="Center" Margin="0,0,10,4" />
            <Slider Minimum="4" Maximum="120" Value="{Binding BrushRadius}" Width="160" VerticalAlignment="Center" Margin="0,0,10,4" />
            <ToggleButton Content="Erase" IsChecked="{Binding IsErasing}" Margin="0,0,10,4" />
            <Button Content="Clear" Click="OnClearMaskCanvasClick" Margin="0,0,0,4" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseMaskEditorCommand}" />
            <Button Content="Done" Click="OnConfirmMaskClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Asset-library picker overlay: browse/select from what's already on the Comfy backend.
         MaxWidth (not a fixed Width) so it shrinks to fit a phone screen in portrait instead of
         overflowing it, and Margin so it never touches the screen edges once it does shrink. -->
    <Grid Background="#AA000000" IsVisible="{Binding IsAssetPickerOpen}">
      <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="16" CornerRadius="6"
              MaxWidth="640" MaxHeight="600" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="Add source images from Comfy assets" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

          <!-- WrapPanel, not DockPanel: on a narrow phone screen these controls don't all fit on
               one line, so they need to wrap onto a second line instead of forcing the whole
               overlay wider than the screen. -->
          <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="Refresh" Command="{Binding AssetLibrary.RefreshCommand}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding AssetLibrary.IsLoading}"
                         Width="18" Height="18" Margin="8,0,0,0" />
            <TextBox Text="{Binding AssetLibrary.TagFilter}" PlaceholderText="Filter by tag…" MinWidth="140" Margin="12,4,0,0" />
            <TextBlock Text="{Binding AssetLibrary.StatusMessage}" VerticalAlignment="Center"
                       Margin="12,4,0,0" MaxWidth="260" TextWrapping="Wrap" />
          </WrapPanel>

          <ScrollViewer Grid.Row="2" ScrollChanged="OnAssetPickerScrollChanged">
            <Panel>
              <TextBlock Text="No assets loaded yet — click Refresh." IsVisible="{Binding !AssetLibrary.HasAssets}"
                         Opacity="0.7" Margin="0,20,0,0" />
              <ItemsControl ItemsSource="{Binding AssetLibrary.FilteredAssets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="140" Margin="4" Padding="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                      <StackPanel Spacing="4">
                        <Grid Height="90">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                          <TextBlock Text="Loading…" IsVisible="{Binding IsLoadingThumbnail}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" FontSize="10" />
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding DisplayName}" />
                        <!-- AddAssetToSourcesCommand lives on EditorViewModel, not on the item
                             itself or on AssetLibrary — $parent[ItemsControl].DataContext is the
                             ItemsControl's own (unscoped, EditorViewModel) DataContext. -->
                        <Button Content="Add" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding $parent[ItemsControl].DataContext.AddAssetToSourcesCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Done" Command="{Binding CloseAssetPickerCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
