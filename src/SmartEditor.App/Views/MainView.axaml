<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:SmartEditor.App.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:CompileBindings="False"
             x:Class="SmartEditor.App.Views.MainView">

  <UserControl.Styles>
    <!-- Distinct, high-contrast tab headers, all pitched against an explicitly-colored page
         background (see the root Grid's Background below) rather than each other: the page itself
         is a mid gray (SystemChromeMediumColor), inactive tabs are a further step darker
         (SystemChromeHighColor) so they read as tabs sitting on the page even before hovering,
         hovering one shifts it again (SystemChromeMediumLowColor), and the active tab uses
         SystemRegionColor — the theme's opposite brightness extreme from the mid-gray page in both
         light and dark variants — plus a colored accent underline, so it visibly pops off the page
         rather than blending into it. Every one of these four surfaces (page, inactive, hover,
         selected) is therefore a genuinely different color, confirmed against Avalonia's actual
         FluentTheme palette values for both theme variants (an earlier attempt using
         SystemChromeLowColor for inactive tabs, and matching the active tab to an unset/default
         page background, turned out nearly indistinguishable in practice). -->
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
      <Setter Property="Background" Value="{DynamicResource SystemChromeHighColor}" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource SystemRegionColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{DynamicResource SystemChromeMediumColor}">
    <!-- Main content: header bar + editor tabs -->
    <Grid RowDefinitions="Auto,*" Margin="16">
      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <Button Content="Settings" DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}" />
        <Button Content="🗂 Assets" DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding OpenAssetsCommand}" />
        <Button Content="+ New tab" DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding AddTabCommand}" />
        <TextBlock Text="SmartEditor" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>

      <!-- No explicit ContentTemplate: the app-wide ViewLocator (see App.axaml) resolves each
           editor tab's content view by naming convention (EditorViewModel -> EditorView). Assets
           are no longer a tab — they're shown via the overlay below instead. -->
      <!-- Background matches the active TabItem's own (SystemRegionColor) so the tab body reads as
           a continuation of the selected tab rather than a visually separate panel sitting on the
           page beneath it. -->
      <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                  Background="{DynamicResource SystemRegionColor}"
                  Focusable="True" SelectionChanged="OnTabControlSelectionChanged">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" MinWidth="90">
              <TextBox Text="{Binding Title}" IsReadOnly="{Binding !IsEditable}"
                        BorderThickness="0" Background="Transparent"
                        Padding="2,0" MinWidth="60" VerticalAlignment="Center"
                        Loaded="OnTabTitleLoaded" />
              <Button Content="✕" Padding="4,0" FontSize="11" VerticalAlignment="Center"
                      IsVisible="{Binding IsClosable}"
                      ToolTip.Tip="Close tab"
                      Command="{Binding $parent[TabControl].DataContext.CloseTabCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>
    </Grid>

    <!-- Settings overlay -->
    <Grid Background="#AA000000" IsVisible="{Binding IsSettingsOpen}">
      <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="20" CornerRadius="6"
              MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="6" DataContext="{Binding Settings}">
          <TextBlock Text="Settings" FontWeight="Bold" FontSize="18" Margin="0,0,0,8" />

          <CheckBox Content="Use Comfy Cloud (cloud.comfy.org)" IsChecked="{Binding IsComfyCloud}" />

          <TextBlock Text="ComfyUI server URL" Margin="0,8,0,0" />
          <TextBox Text="{Binding ComfyUiBaseUrl}" PlaceholderText="http://192.168.1.50:8188" />

          <StackPanel IsVisible="{Binding IsComfyCloud}">
            <TextBlock Text="Comfy Cloud API key (stored locally, unencrypted)" Margin="0,8,0,0" />
            <TextBox Text="{Binding ComfyCloudApiKey}" PasswordChar="•" />

            <TextBlock Text="Asset page size (per scroll-load)" Margin="0,8,0,0" />
            <Slider Minimum="10" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding AssetPageSize}" />
            <TextBlock Text="{Binding AssetPageSize}" HorizontalAlignment="Right" />
          </StackPanel>

          <TextBlock Text="LLM base URL (OpenAI-compatible — OpenRouter, DeepInfra, …)" Margin="0,8,0,0" />
          <TextBox Text="{Binding LlmBaseUrl}" PlaceholderText="https://openrouter.ai/api/v1" />

          <TextBlock Text="LLM API key (stored locally, unencrypted)" Margin="0,8,0,0" />
          <TextBox Text="{Binding LlmApiKey}" PasswordChar="•" />

          <TextBlock Text="LLM model id" Margin="0,8,0,0" />
          <TextBox Text="{Binding LlmModel}" PlaceholderText="e.g. anthropic/claude-sonnet-4.5" />

          <CheckBox Content="Provider reliably supports strict JSON-schema output" IsChecked="{Binding LlmSupportsJsonSchema}" Margin="0,8,0,0" />

          <TextBlock Text="Max iterations" Margin="0,8,0,0" />
          <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxIterations}" />
          <TextBlock Text="{Binding MaxIterations}" HorizontalAlignment="Right" />

          <TextBlock Text="{Binding CleartextWarning}" Foreground="OrangeRed" TextWrapping="Wrap"
                     IsVisible="{Binding HasCleartextWarning}" Margin="0,8,0,0" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding $parent[Grid].DataContext.CancelSettingsCommand}" />
            <Button Content="Save" Command="{Binding $parent[Grid].DataContext.SaveSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Assets overlay: the same full asset browser previously shown as its own permanent tab,
         now opened on demand from the header button instead. -->
    <Grid Background="#AA000000" IsVisible="{Binding IsAssetsOpen}">
      <Border Background="{DynamicResource SystemChromeMediumColor}" Padding="16" CornerRadius="6"
              Width="900" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*">
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Close" DockPanel.Dock="Right" Command="{Binding CloseAssetsCommand}" />
            <TextBlock Text="Assets" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
          </DockPanel>
          <views:AssetsView Grid.Row="1" DataContext="{Binding Assets}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
